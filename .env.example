# Database (for direct run; docker-compose overrides this)
DATABASE_URL=mysql+pymysql://makerspace:makerspace@localhost:3306/makerspaceapi

# MariaDB (used by docker-compose)
DB_ROOT_PASSWORD=rootpassword # Generate a safe password
DB_NAME=makerspaceapi
DB_USER=makerspace
DB_PASSWORD=makerspace

# OIDC
OIDC_CLIENT_ID=makerspaceapi # Paste from your OIDC provider
OIDC_CLIENT_SECRET=your-client-secret-here # Paste from your OIDC provider
OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
OIDC_ADMIN_GROUP=makerspace-admins # or what ever your admin group is called
# Optional: OIDC group whose members can manage products, inventory, aliases and categories.
# Leave empty (or omit) to restrict product management to admins only.
# OIDC_PRODUCT_MANAGER_GROUP=
# Optional: OIDC group whose members can book, import and categorize ledger entries (Kassenwart).
# Leave empty (or omit) to restrict ledger management to admins only.
# OIDC_TREASURER_GROUP=
# Optional: OIDC group with read-only ledger access for the Kassenprüfer (annual audit).
# Leave empty (or omit) to restrict ledger viewing to admins/treasurers only.
# OIDC_AUDITOR_GROUP=
OIDC_GROUP_CLAIM=groups
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback # Adjust to your production url like https://api.makerspace.example/auth/callback

# App
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
BASE_URL=http://localhost:8000 # Also adjust this to your production url

# Optional: set true to overwrite user.name from OIDC claims on NFC self-service card linking
# OIDC_LINK_UPDATE_NAME=false

# Optional: comma-separated slugs of checkout box devices
# (restricts user creation endpoint to these devices)
CHECKOUT_BOX_SLUGS=nfckasse

# Optional: allow purchases when stock is 0 (stock goes negative, default: false)
# ALLOW_NEGATIVE_STOCK=false

# Currency symbol appended to all monetary amounts in API messages and PDF statements (default: €)
CURRENCY=€

# Require an EÜR-Sphäre on every ledger category (default: true). Only relevant for
# gemeinnützige Vereine — set to false for commercial installations (e.g. a
# for-profit FabLab) that don't need Sphärentrennung.
# LEDGER_SPHERES_ENABLED=true

# Optional: link ledger entries to receipts stored in Paperless-ngx. Leave both
# empty to disable (the document-search UI hides itself; paperless_document_id
# still works as a plain opaque string either way).
# PAPERLESS_URL=https://paperless.example.com
# PAPERLESS_API_TOKEN=

# Optional: manual FinTS bank statement live-pull (no scheduled automation,
# no stored bank credentials — only a registered product ID). Leave empty to
# disable (the FinTS wizard hides itself in the Ledger import tab; only the
# MT940/CAMT.053 file upload stays available). Register a product ID with the
# Deutsche Kreditwirtschaft: https://www.hbci-zka.de/register/prod_register.htm
# FINTS_PRODUCT_ID=

# IANA timezone for timestamp display in the web frontend (default: Europe/Berlin)
TIMEZONE=Europe/Berlin

# PDF statement generation via typst
# Optional: path to a directory containing extra font files (e.g. albertsans.ttf)
TYPST_FONT_DIR=/app/statements/fonts
