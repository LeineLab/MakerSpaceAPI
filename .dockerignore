# Version control
.git/
.github/

# Local config / secrets
.env
.env.*
!.env.example

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Node deps — installed fresh via `npm ci` in the CSS build stage
node_modules/

# Tests
tests/
*.db

# Dev / docs
.claude/
README.md
CLAUDE.md
Logo.af

# Legacy hardware connectors and migration scripts (not needed in production image)
projects/
scripts/

# Docker / compose files (no need to copy into the image)
docker-compose*.yml
Dockerfile

# Note: package.json, package-lock.json and tailwind.config.js are intentionally
# NOT ignored — the CSS build stage needs them to compile Tailwind at image build.

# Local runtime mounts (logo, fonts, data)
logo.svg
fonts/
data/
